---
source: crates/mtui-mcp/tests/document_tools.rs
expression: pretty
---
[
  {
    "description": "List the report document's sections (`name`, byte `size` — advisory, `has_unanswered`) and its completeness: `complete`, and `unfilled`, the RFC 6901 pointer of every null leaf. `dirty` is true while edits are not yet uploaded by `commit`. Needs a loaded report document; without one it refuses (run load_template or regenerate). Pass `template=<rrid>` to target a specific loaded template; required when more than one is loaded.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "template": {
          "description": "RRID of a loaded template to target (required when >1 loaded).",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "report_sections",
    "read_only": true
  },
  {
    "description": "Read one section of the report document as JSON (`data`). Needs a loaded report document; without one it refuses (run load_template or regenerate). Pass `template=<rrid>` to target a specific loaded template; required when more than one is loaded.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "section": {
          "description": "Section to read.",
          "enum": [
            "verdict",
            "comment",
            "people",
            "update",
            "install",
            "issues",
            "new_issues",
            "testing",
            "review"
          ],
          "type": "string"
        },
        "template": {
          "description": "RRID of a loaded template to target (required when >1 loaded).",
          "type": "string"
        }
      },
      "required": [
        "section"
      ],
      "type": "object"
    },
    "name": "report_section_read",
    "read_only": true
  },
  {
    "description": "Replace one tester section of the report document with `value`. `update` and `install` are pipeline-owned and refused; a section the report lacks (`review` on a PI report) is refused; an `issues` write must keep exactly the same issue keys (use report_issue_write for one entry); `new_issues` is the list of tester-filed bugs and a write replaces it (report_new_issue_write changes one). Validated against the report schema locally, refused with the offending pointers, and applied to local state only; `commit` uploads it. A later `export` overwrites testing.install, testing.openqa and people.testers. Needs a loaded report document; without one it refuses (run load_template or regenerate). Pass `template=<rrid>` to target a specific loaded template; required when more than one is loaded.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "section": {
          "description": "Tester section to replace.",
          "enum": [
            "verdict",
            "comment",
            "people",
            "issues",
            "new_issues",
            "testing",
            "review"
          ],
          "type": "string"
        },
        "template": {
          "description": "RRID of a loaded template to target (required when >1 loaded).",
          "type": "string"
        },
        "value": {
          "description": "The section's new JSON value, shaped as report_section_read returns it."
        }
      },
      "required": [
        "section",
        "value"
      ],
      "type": "object"
    },
    "name": "report_section_write",
    "read_only": false
  },
  {
    "description": "Without `issue_id`, list the report's issues (`id`, `title`, `status`, `severity`, `new` — true for a tester-filed bug); with it, read that issue in full. Needs a loaded report document; without one it refuses (run load_template or regenerate). Pass `template=<rrid>` to target a specific loaded template; required when more than one is loaded.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "issue_id": {
          "description": "Issue key such as `bsc#1234567`; omit to list all.",
          "type": "string"
        },
        "template": {
          "description": "RRID of a loaded template to target (required when >1 loaded).",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "report_issue_read",
    "read_only": true
  },
  {
    "description": "Replace one existing issue of the report document with `value`; the issue set cannot grow or shrink (use report_new_issue_write / report_new_issue_delete for tester-filed bugs). Validated against the report schema locally, refused with the offending pointers, and applied to local state only; `commit` uploads it. Needs a loaded report document; without one it refuses (run load_template or regenerate). Pass `template=<rrid>` to target a specific loaded template; required when more than one is loaded.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "issue_id": {
          "description": "Key of an existing issue, such as `bsc#1234567`.",
          "type": "string"
        },
        "template": {
          "description": "RRID of a loaded template to target (required when >1 loaded).",
          "type": "string"
        },
        "value": {
          "description": "The issue's new JSON value, shaped as report_issue_read returns it."
        }
      },
      "required": [
        "issue_id",
        "value"
      ],
      "type": "object"
    },
    "name": "report_issue_write",
    "read_only": false
  },
  {
    "description": "File a bug the tester found during validation, or update the `title`/`comment` of one already filed (`new: true` in report_issue_read). An existing entry keeps its reproducer, status and severity; an empty `comment` clears it. A pipeline issue is refused: use report_issue_write for those. Validated against the report schema locally, refused with the offending pointers, and applied to local state only; `commit` uploads it. Needs a loaded report document; without one it refuses (run load_template or regenerate). Pass `template=<rrid>` to target a specific loaded template; required when more than one is loaded.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "comment": {
          "description": "Optional free text about the bug.",
          "type": "string"
        },
        "issue_id": {
          "description": "Bug key such as `bsc#1234567` (bsc, bnc, boo, jsc or ijsc).",
          "type": "string"
        },
        "template": {
          "description": "RRID of a loaded template to target (required when >1 loaded).",
          "type": "string"
        },
        "title": {
          "description": "Bug summary.",
          "type": "string"
        }
      },
      "required": [
        "issue_id",
        "title"
      ],
      "type": "object"
    },
    "name": "report_new_issue_write",
    "read_only": false
  },
  {
    "description": "Remove a bug the tester filed with report_new_issue_write. Pipeline issues cannot be removed and are refused. Validated against the report schema locally, refused with the offending pointers, and applied to local state only; `commit` uploads it. Needs a loaded report document; without one it refuses (run load_template or regenerate). Pass `template=<rrid>` to target a specific loaded template; required when more than one is loaded.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "issue_id": {
          "description": "Key of a tester-filed bug, such as `bsc#1234567`.",
          "type": "string"
        },
        "template": {
          "description": "RRID of a loaded template to target (required when >1 loaded).",
          "type": "string"
        }
      },
      "required": [
        "issue_id"
      ],
      "type": "object"
    },
    "name": "report_new_issue_delete",
    "read_only": false
  },
  {
    "description": "List the report directory's files — `build_checks/`, the install-log directory, `results/` and `checkers.log` — each with its report-relative `path`, `name` and `size`. `server` is the matching teregen artifact (`origin`, `size`, `at`), or null when the server has none; sizes differ until `commit` uploads. `server_only` lists server files with no local copy: report_file_read can read them. A failed server listing leaves the local list and sets `server_error`. Needs a loaded report document; without one it refuses (run load_template or regenerate). Pass `template=<rrid>` to target a specific loaded template; required when more than one is loaded.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "template": {
          "description": "RRID of a loaded template to target (required when >1 loaded).",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "report_files",
    "read_only": true
  },
  {
    "description": "Read one report file as text: `content` and `total_lines`. `path` is relative to the report directory and must be `checkers.log` or sit directly in `build_checks/`, the install-log directory or `results/` (see report_files). `offset`/`limit` page a 1-indexed line window; a window also returns `offset` and `returned_lines`. A file with no local copy falls back to the server's, and the result then carries `\"source\": \"server\"`. Needs a loaded report document; without one it refuses (run load_template or regenerate). Pass `template=<rrid>` to target a specific loaded template; required when more than one is loaded.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "description": "Max lines to return (default: to end of file).",
          "minimum": 0,
          "type": "integer"
        },
        "offset": {
          "default": 1,
          "description": "1-based first line to return.",
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "description": "Report-directory-relative file, e.g. `install_logs/<host>.log` or `checkers.log`.",
          "type": "string"
        },
        "template": {
          "description": "RRID of a loaded template to target (required when >1 loaded).",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "name": "report_file_read",
    "read_only": true
  }
]
