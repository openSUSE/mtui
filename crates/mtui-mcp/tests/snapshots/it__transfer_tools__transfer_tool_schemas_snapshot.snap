---
source: crates/mtui-mcp/tests/transfer_tools.rs
expression: pretty
---
[
  {
    "description": "Download a file from every enabled host, content in-band per host (`content` utf-8, `content_b64` binary, always with remote `size` and `truncated`). Capped per host at [mcp] max_input_bytes plus an equal share of [mcp] max_output_bytes; pass `hosts` to retry or page a subset. No folders in-band (trailing / unsupported). Any host failure fails the call, naming the host. Pass `template=<rrid>` to target a specific loaded template; required when more than one is loaded.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "hosts": {
          "description": "Subset of connected hostnames; unknown or disabled names refuse the call.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "remote": {
          "description": "Absolute path of the file on the reference hosts.",
          "type": "string"
        },
        "template": {
          "description": "RRID of a loaded template to target (required when >1 loaded).",
          "type": "string"
        }
      },
      "required": [
        "remote"
      ],
      "type": "object"
    },
    "name": "get",
    "read_only": true
  },
  {
    "description": "Upload `content` (utf-8) or `content_b64` (exactly one) to `<target tempdir>/<filename>` on every enabled host. Payloads above [mcp] max_input_bytes are refused, not truncated. Any host failure fails the call, naming the host. Pass `template=<rrid>` to target a specific loaded template; required when more than one is loaded.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "description": "UTF-8 payload; exactly one of content/content_b64.",
          "type": "string"
        },
        "content_b64": {
          "description": "Base64 payload; exactly one of content/content_b64.",
          "type": "string"
        },
        "filename": {
          "description": "Bare file name to create on the hosts (no path separators).",
          "type": "string"
        },
        "template": {
          "description": "RRID of a loaded template to target (required when >1 loaded).",
          "type": "string"
        }
      },
      "required": [
        "filename"
      ],
      "type": "object"
    },
    "name": "put",
    "read_only": false
  }
]
