---
source: crates/mtui-mcp/tests/transfer_tools.rs
expression: pretty
---
[
  {
    "description": "Download a file from every enabled host, content in-band per host (`content` utf-8, `content_b64` binary, always with full remote `size` and `truncated`). Capped per host at [mcp] max_input_bytes plus an equal share of [mcp] max_output_bytes; pass `hosts` to retry or page a subset. No folders in-band (trailing / unsupported). Any host failure fails the call, naming the host. With no template loaded, acts on the hosts added with add_host. Pass `template=<rrid>` to target a specific loaded template; required when more than one is loaded.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "hosts": {
          "description": "Subset of connected hostnames; unknown or disabled names refuse the call.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "remote": {
          "description": "Absolute path of the file on the reference hosts.",
          "type": "string"
        },
        "template": {
          "description": "RRID of a loaded template to target (required when >1 loaded).",
          "type": "string"
        }
      },
      "required": [
        "remote"
      ],
      "type": "object"
    },
    "name": "get",
    "read_only": true
  },
  {
    "description": "Upload `content` (utf-8), `content_b64` or `source` (exactly one) to `<target tempdir>/<filename>` on every enabled host. `source` is an absolute path of a file on the mtui-mcp server inside an [mcp] put_dirs directory (refused when put_dirs is unset); it is uploaded byte for byte without passing through the call, `filename` defaults to its basename, and the reply carries `source` {path, bytes, sha256}. Payloads above [mcp] max_input_bytes are refused, not truncated. Any host failure fails the call, naming the host. `hosts` limits the write to a subset. Writes even where another owner holds the operation lock (an upload is not a zypper transaction); leave such a host out with `hosts` or set_host_state. With no template loaded, acts on the hosts added with add_host. Pass `template=<rrid>` to target a specific loaded template; required when more than one is loaded.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "description": "UTF-8 payload; exactly one of content/content_b64/source.",
          "type": "string"
        },
        "content_b64": {
          "description": "Base64 payload; exactly one of content/content_b64/source.",
          "type": "string"
        },
        "filename": {
          "description": "Bare file name to create on the hosts (no path separators); defaults to the basename of `source`.",
          "type": "string"
        },
        "hosts": {
          "description": "Subset of connected hostnames; unknown or disabled names refuse the call.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "source": {
          "description": "Absolute path of a file on the mtui-mcp server, inside an [mcp] put_dirs directory; uploaded byte for byte without passing through the call. Exactly one of content/content_b64/source.",
          "type": "string"
        },
        "template": {
          "description": "RRID of a loaded template to target (required when >1 loaded).",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "put",
    "read_only": false
  }
]
