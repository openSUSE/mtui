---
source: crates/mtui-mcp/tests/transfer_tools.rs
expression: pretty
---
[
  {
    "description": "Download a file from every enabled reference host and return its content in-band, per host: UTF-8 content as `content`, binary as `content_b64`, always with the full remote `size` and a `truncated` flag (per-host reads are capped at [mcp] max_input_bytes and each host gets an equal share of [mcp] max_output_bytes on the wire). Pass `hosts` to retry or page a subset. Folder paths (trailing `/`) are not supported in-band. Any host failure fails the call and names the host. Pass `template=<rrid>` to target a specific loaded template; required when more than one is loaded.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "hosts": {
          "description": "Subset of connected hostnames; unknown or disabled names refuse the call.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "remote": {
          "description": "Absolute path of the file on the reference hosts.",
          "type": "string"
        },
        "template": {
          "description": "RRID of a loaded template to target (required when >1 loaded).",
          "type": "string"
        }
      },
      "required": [
        "remote"
      ],
      "type": "object"
    },
    "name": "get",
    "read_only": true
  },
  {
    "description": "Upload a payload carried in the call to every enabled reference host, at `<target tempdir>/<filename>` — the same place the REPL `put` command uploads to. Pass the payload as `content` (UTF-8) or `content_b64` (base64), exactly one of the two; payloads above [mcp] max_input_bytes are refused rather than truncated. Any host failure fails the call and names the host. Pass `template=<rrid>` to target a specific loaded template; required when more than one is loaded.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "description": "UTF-8 payload; exactly one of content/content_b64.",
          "type": "string"
        },
        "content_b64": {
          "description": "Base64 payload; exactly one of content/content_b64.",
          "type": "string"
        },
        "filename": {
          "description": "Bare file name to create on the hosts (no path separators).",
          "type": "string"
        },
        "template": {
          "description": "RRID of a loaded template to target (required when >1 loaded).",
          "type": "string"
        }
      },
      "required": [
        "filename"
      ],
      "type": "object"
    },
    "name": "put",
    "read_only": false
  }
]
